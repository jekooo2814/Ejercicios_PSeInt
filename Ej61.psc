Algoritmo Ej61
    Definir clave Como Entero
    clave <- 0
    Mientras clave <> 1234 Hacer
        Escribir "Introduce la contraseña"
        Leer clave
        Si clave <> 1234 Entonces
            Escribir "Contraseña incorrecta"
        FinSi
    FinMientras
    Escribir "Bienvenido"
FinAlgoritmo
