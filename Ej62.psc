Algoritmo Ej62
    Definir num1, num2, suma Como Real
    num1 <- 1
    num2 <- 1
    Mientras num1 <> 0 O num2 <> 0 Hacer
        Escribir "Introduce un número"
        Leer num1
        Escribir "Introduce un número"
        Leer num2
        Si num1 <> 0 O num2 <> 0 Entonces
            suma <- num1 + num2
            Escribir "La suma de ambos números es: ", suma
        FinSi
    FinMientras
FinAlgoritmo
